{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "https://psychic-fortnight-rr5ppq554pwhx7jx-4200.app.github.dev",
    "http://localhost:4200"
  ],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": {
      "FileInfoSink": {
        "Name": "File",
        "Args": {
          "path": "C:/TTGAppLogs/Expenses/expenseapi-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {MachineName} v{AppVersion} {EnvironmentName} {RequestId} {UserIdentifier} {ClientIpAddress}  {Message:lj}{NewLine}{Exception}"
        }
      }
    }
  }

  //"Serilog": {
