{
  "Serilog": {
    "WriteTo": {
      "FileInfoSink": {
        "Name": "File",
        "Args": {
          "path": "$(Serilog:Properties:LogDrive):/TTGAppLogs/Expenses/$(Serilog:Properties:Application)-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {MachineName} v{AppVersion} {EnvironmentName} {RequestId} {UserIdentifier} {ClientIpAddress}  {Message:lj}{NewLine}{Exception}"
        }
      },
      "EventLogSink": {
        "Name": "EventLog",
        "Args": {
          "logName": "SampleApps",
          "source": "ExpensesApi",
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {MachineName} v{AppVersion} {EnvironmentName} {RequestId} {UserIdentifier} {ClientIpAddress}  {Message:lj}{NewLine}{Exception}"
        }
      }
    },
    "Properties": {
      "LogDrive": "C"
    }
  }
}
